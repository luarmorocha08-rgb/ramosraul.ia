# ─── Site ──────────────────────────────────────────────────────────────
# URL pública (usada em metadados, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://ramosraul.ia.example

# Contato (deixe vazio para ocultar o botão correspondente)
# WhatsApp no formato internacional, apenas dígitos. Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Inteligência Artificial (Claude API) ──────────────────────────────
# Sem esta chave o AI Lab roda em MODO DEMONSTRAÇÃO (claramente sinalizado).
# A chave é usada apenas no servidor; nunca é enviada ao navegador.
ANTHROPIC_API_KEY=
# Modelo (opcional). Padrão: claude-opus-5-5
ANTHROPIC_MODEL=
# Esforço de raciocínio: low | medium | high (opcional). Padrão: low
ANTHROPIC_EFFORT=

# Limites de uso por visitante (opcionais)
AI_RATE_LIMIT_PER_MINUTE=8
AI_DAILY_REQUESTS_PER_SESSION=40

# ─── Supabase (persistência de leads do formulário) ────────────────────
# Sem estas variáveis o formulário valida, mas informa que o envio
# online não está ativo e oferece WhatsApp/e-mail/Instagram.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
